<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
    Allows the application to download map styles and map tiles
    required to display the Toronto Treasure Hunt map.
-->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Allows the Treasure Hunt application to access the participant's
        approximate location when precise GPS positioning is unavailable
        or when the user grants only approximate location access.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        Allows the application to access precise device location so it can
        determine when a participant has reached a treasure destination.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidApp3">
        <!--
    Displays the participant's Treasure Hunt completion progress.
    Future destinations remain locked until they are reached in sequence.
-->
        <activity
            android:name=".TreasureProgressActivity"
            android:exported="false" />
        <!--
    Displays detailed information for the treasure location
        selected by the participant.
        -->
        <activity
            android:name=".TreasureDetailActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
    Securely shares treasure photo files with the device camera application.

    FileProvider converts private application file paths into temporary
    content URIs, avoiding direct exposure of the application's filesystem.
-->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <!--
                References the FileProvider path configuration stored in
                res/xml/file_paths.xml.
            -->
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />

        </provider>


    </application>

</manifest>