<?xml version="1.0" encoding="utf-8"?>

<!--
    Main layout for the Toronto Treasure Hunt application.

    The MapLibre map occupies the full screen while the participant controls
    are displayed in a vertical panel near the bottom of the screen.

    Visible button text is referenced from strings.xml so the layout avoids
    hardcoded-string lint warnings and remains easier to maintain.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        Displays the interactive Toronto Treasure Hunt map.

        The map fills the entire screen and remains behind the participant
        controls positioned near the bottom of the layout.
    -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        Groups the main Treasure Hunt controls into one vertical panel.

        Keeping the controls inside a shared container provides consistent
        spacing and prevents the buttons from overlapping each other.
    -->
    <LinearLayout
        android:id="@+id/treasureControlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical">

        <!--
            Opens the Treasure Hunt Progress screen.
        -->
        <Button
            android:id="@+id/viewProgressButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/view_progress" />

        <!--
            Requests a fresh device location reading so MainActivity can
            determine whether the active treasure has been reached.
        -->
        <Button
            android:id="@+id/checkLocationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/check_my_location" />

    </LinearLayout>

</FrameLayout>