<?xml version="1.0" encoding="utf-8"?>

<!--
    Progress screen for the Toronto Treasure Hunt.

    The screen summarizes the participant's completion status and displays
    completed, current, and locked treasure stops in a scrollable list.

    Static visible text is referenced from strings.xml to improve
    maintainability and remove hardcoded-string lint warnings.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <!--
        Main heading for the Treasure Hunt progress screen.
    -->
    <TextView
        android:id="@+id/progressTitleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/treasure_hunt_progress"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Displays a dynamic summary such as:
        "1 of 21 treasures completed".

        The text is populated programmatically by TreasureProgressActivity.
    -->
    <TextView
        android:id="@+id/progressSummaryTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="17sp"
        app:layout_constraintTop_toBottomOf="@id/progressTitleTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Scrollable area containing the dynamically generated treasure rows.

        TreasureProgressActivity adds completed, current, and locked
        destination rows to progressContainer at runtime.
    -->
    <ScrollView
        android:id="@+id/progressScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/progressSummaryTextView"
        app:layout_constraintBottom_toTopOf="@id/progressBackButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--
            Vertical container populated programmatically with treasure
            progress rows.
        -->
        <LinearLayout
            android:id="@+id/progressContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <!--
        Returns the participant to the main Treasure Hunt map.
    -->
    <Button
        android:id="@+id/progressBackButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/back_to_map"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>